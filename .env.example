# Настройки бота. Необязательные интеграции пока не используются.
# Локальные значения хранить в .env; реальные секреты сюда не добавлять.

# Приложение
APP_ENV=local
LOG_LEVEL=INFO
TIMEZONE=Europe/Moscow

# Telegram: токен от @BotFather
TELEGRAM_BOT_TOKEN=

# AI: заполнить после выбора провайдера и модели
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=

# Данные о киберспортивных матчах: провайдер пока не выбран
ESPORTS_API_KEY=
ESPORTS_API_BASE_URL=

# Хранилище: заполнить после выбора базы данных
DATABASE_URL=
