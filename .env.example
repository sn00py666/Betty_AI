# Скопируйте в .env. Не добавляйте реальные секреты в Git.
TELEGRAM_BOT_TOKEN=
LOG_LEVEL=INFO
# Числовые Telegram ID модераторов, например [123456789]. Боту нужно отправить /start.
ADMIN_USER_IDS=[]
VALVE_RANKINGS_ENABLED=true
# Рейтинг Dota 2: OpenDota — основной, публичный топ-20 CyberScore — резервный.
# Независимое обновление раз в сутки; ключи API не требуются.
DOTA_OPENDOTA_ENABLED=true
DOTA_CYBERSCORE_ENABLED=true
CUSTOM_EMOJI_ENABLED=true
# Партнёрские предложения: меньший priority показывается первым; enabled включает публикацию.
# Формат и пример без реальных коммерческих условий: docs/bot-presentation.md.
BONUS_OFFERS=[]

# OpenRouter; без ключа останется сравнение коэффициентов.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemini-2.5-flash-lite
AI_TEMPERATURE=0.35
AI_DAILY_LIMIT=500

# Бесплатный Fixtures API PandaScore. Общий кеш хранится в data/pandascore.json.
PANDASCORE_API_KEY=
PANDASCORE_DAILY_LIMIT=100
